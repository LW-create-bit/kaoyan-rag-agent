# ============================================================
# API 配置模板
#
# 云端 Cloud Studio 的同学不用手动改这个文件 ——
# 02_LLM_API与chatbot.ipynb 会引导你用 getpass 输入密钥并自动生成 .env。
#
# 手动使用：cp .env.example .env  然后填入自己的密钥
#
# .env 已被 .gitignore 忽略。
# 不要提交，不要写进 Notebook，不要发群里。
# ============================================================

# ---------- 大语言模型（四选一，都是 OpenAI 兼容格式） ----------

# 主渠道：Agnes AI —— 
#   注意是 .cn 国内站，.com 是国际站，账号密钥不通用
API_KEY=
BASE_URL=https://api.agnes-ai.cn/v1
MODEL_ID=agnes-2.5-flash

# 备选一：魔搭社区 ModelScope —— https://modelscope.cn
#   免费资料：https://www.modelscope.cn/learn/1409
#   注意：必须先在「模型服务」绑定阿里云账号，否则一直报错
# BASE_URL=https://api-inference.modelscope.cn/v1/
# MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# 备选二：DeepSeek（付费，便宜）—— https://platform.deepseek.com
#   具体模型名以平台当前列表为准
# BASE_URL=https://api.deepseek.com/v1
# MODEL_ID=

# 备选三：国外免费渠道（需要魔法）
#   opencode zen / OpenRouter / NVIDIA build 的 free model

# ---------- 搜索工具（博查 Bocha） ----------
# Bocha：本考研Agent联网搜索工具，用于实时获取院校分数线、报录比、招生信息
# 不填写密钥时，联网搜索功能会自动降级，仅使用本地向量知识库回答
# 官网：https://bochaai.com/
BOCHA_API_KEY=
